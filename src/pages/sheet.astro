---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import DrawnPiece from '@/components/world/DrawnPiece.astro';
import Badge from '@/components/starwind/badge/Badge.astro';
import Button from '@/components/starwind/button/Button.astro';
import Separator from '@/components/starwind/separator/Separator.astro';
import { pieces } from '@/data/pieces';
import { url } from '@/lib/url';

const piece = pieces[1];
---

<Base title={`${piece.name} — بطاقة القطعة`}>
  <SiteHeader />
  <main class="mx-auto max-w-6xl px-5 py-8 lg:px-8">
    <nav class="mb-6 flex items-center gap-2 text-[0.8125rem] wq-ink-room-3" aria-label="المسار">
      <a href={url('/')} class="transition-colors hover:wq-ink-room">القاعة</a>
      <span aria-hidden="true">‹</span>
      <a href={url('/catalog')} class="transition-colors hover:wq-ink-room">الفهرس</a>
      <span aria-hidden="true">‹</span>
      <span class="wq-ink-room">{piece.name}</span>
    </nav>

    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div
        class="relative flex min-h-80 items-center justify-center border border-accent/55 wq-surface-deep p-10"
      >
        <DrawnPiece kind={piece.kind} class="h-64 w-auto wq-ink-deep opacity-85" />
        <p
          class="absolute bottom-4 start-6 font-data text-xs tracking-[0.18em] wq-ink-deep-2"
          dir="ltr"
        >
          {piece.no}
        </p>
      </div>

      <div class="space-y-5">
        <div class="flex items-baseline gap-3 border-b wq-edge pb-3">
          <span class="font-data text-[0.75rem] tracking-[0.14em] text-accent-d" dir="ltr"
            >{piece.no}</span
          >
          <span class="text-[0.8125rem] wq-ink-room-2">{piece.origin}</span>
          <Badge variant="outline" size="sm" class="ms-auto wq-edge wq-ink-room-3" dir="ltr"
            >WQ</Badge
          >
        </div>

        <h1
          class="relative pb-4 font-display text-4xl leading-tight wq-ink-room after:absolute after:bottom-0 after:start-0 after:h-[3px] after:w-10 after:bg-accent lg:text-5xl"
        >
          {piece.name}
        </h1>

        <p class="max-w-prose font-reading text-lg leading-loose wq-ink-room-2">
          {piece.standard} هذه القطعة دخلت القاعة لأنها تجاوزت المقارنة مع نظيراتها في الجودة والذوق
          معًا، لا في السعر وحده.
        </p>

        <Separator />

        <dl class="grid grid-cols-2 gap-4 text-sm">
          <div class="space-y-1">
            <dt class="font-data text-[0.7rem] tracking-[0.1em] wq-ink-room-3">الأصل</dt>
            <dd class="wq-ink-room-2">{piece.origin}</dd>
          </div>
          <div class="space-y-1">
            <dt class="font-data text-[0.7rem] tracking-[0.1em] wq-ink-room-3">المعيار</dt>
            <dd class="wq-ink-room-2">الجودة · الذوق · القيمة</dd>
          </div>
        </dl>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <Button
            variant="primary"
            class="bg-accent text-ink hover:bg-accent-d hover:text-ink dark:bg-accent dark:text-ink"
          >
            أضف إلى الطلب
          </Button>
          <Button as="a" href={url('/catalog')} variant="outline">عُد إلى الفهرس</Button>
        </div>

        <p class="font-reading text-base leading-loose wq-ink-room-3">
          الرسم خطّيّ لا مصوّر — تُستبدل الصور بصور القطع الحقيقية في نسخة المتجر.
        </p>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>
