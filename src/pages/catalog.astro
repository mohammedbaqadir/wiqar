---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import ProductGrid from '@/components/world/ProductGrid.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import { getProducts } from '@/lib/api';
import { toArabicDigits } from '@/lib/format';

const products = await getProducts();
---

<Base title="المتجر — وقار">
  <SiteHeader />
  <main>
    <header class="border-b border-room bg-exhibit-2">
      <div class="mx-auto max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
        <p class="font-data text-[0.75rem] tracking-[0.18em] text-accent-d">المتجر</p>
        <h1 class="mt-2 font-display text-4xl leading-tight text-room-ink lg:text-5xl">
          كل المقتنيات
        </h1>
        <p class="mt-3 max-w-prose font-reading text-base leading-loose text-room-ink-2 lg:text-lg">
          {toArabicDigits(products.length)} قطعة معروضة الآن، وكل واحدة مرّت بالمعيار نفسه: الجودة والذوق والقيمة.
        </p>
      </div>
    </header>

    <ProductGrid products={products} />
  </main>
  <SiteFooter />
</Base>
