---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import ProductGrid from '@/components/world/ProductGrid.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import { getCategories, getProducts } from '@/lib/api';
import { toArabicDigits } from '@/lib/format';

const products = await getProducts();
const categories = await getCategories();

const rooms = categories
  .map((category) => ({
    category,
    count: products.filter((product) => product.category_id === category.id).length,
  }))
  .filter((room) => room.count > 0);
---

<Base title="المتجر — وقار">
  <SiteHeader />

  <main>
    <header class="border-b border-hairline bg-exhibit-2">
      <div class="mx-auto max-w-6xl px-5 py-10 lg:px-8 lg:py-14">
        <p class="font-data text-[0.75rem] tracking-[0.18em] text-accent-d">المتجر</p>
        <h1 class="mt-2 font-display text-4xl leading-tight text-room-ink lg:text-5xl">
          كل المقتنيات
        </h1>
        <p class="mt-3 max-w-prose font-reading text-base leading-loose text-room-ink-2 lg:text-lg">
          {toArabicDigits(products.length)} قطعة معروضة الآن، وكل واحدة مرّت بالمعيار نفسه: الجودة والذوق والقيمة.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <button
            type="button"
            data-category-chip
            data-category=""
            aria-pressed="true"
            class="inline-flex min-h-11 items-center gap-2 border border-hairline px-3.5 text-sm text-room-ink transition-colors hover:border-outline aria-pressed:border-outline aria-pressed:bg-exhibit"
          >
            الكل
            <span class="font-data text-[0.65rem] text-room-ink-3" dir="ltr">
              {toArabicDigits(products.length)}
            </span>
          </button>

          {
            rooms.map(({ category, count }) => (
              <button
                type="button"
                data-category-chip
                data-category={category.slug}
                aria-pressed="false"
                class="inline-flex min-h-11 items-center gap-2 border border-hairline px-3.5 text-sm text-room-ink-2 transition-colors hover:border-outline hover:text-room-ink aria-pressed:border-outline aria-pressed:bg-exhibit aria-pressed:text-room-ink"
              >
                {category.name}
                <span class="font-data text-[0.65rem] text-room-ink-3" dir="ltr">
                  {toArabicDigits(count)}
                </span>
              </button>
            ))
          }
        </div>

        <p data-catalog-count class="mt-4 font-data text-[0.8rem] text-room-ink-2"></p>
      </div>
    </header>

    <script is:inline>
      (function () {
        if (!new URLSearchParams(location.search).get('category')) return;
        document.documentElement.setAttribute('data-filtering', '');
      })();
    </script>

    <div data-client-filter>
      <ProductGrid products={products} indexed />
    </div>
  </main>

  <SiteFooter />
</Base>

<script>
  import { toArabicDigits } from '@/lib/format';

  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-card]'));
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-category-chip]'));
  const countEl = document.querySelector<HTMLElement>('[data-catalog-count]');

  if (cards.length > 0) {
    const apply = (slug: string) => {
      document.documentElement.removeAttribute('data-filtering');

      let shown = 0;
      cards.forEach((card) => {
        const matched = slug === '' || card.dataset.category === slug;
        card.style.display = matched ? '' : 'none';
        if (matched) shown += 1;
      });

      chips.forEach((chip) =>
        chip.setAttribute('aria-pressed', String((chip.dataset.category ?? '') === slug))
      );

      if (countEl) {
        countEl.textContent = slug
          ? `${toArabicDigits(shown)} من ${toArabicDigits(cards.length)} قطعة`
          : '';
      }

      const next = new URL(location.href);
      if (slug) next.searchParams.set('category', slug);
      else next.searchParams.delete('category');
      history.replaceState(null, '', next);
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => apply(chip.dataset.category ?? ''))
    );

    apply(new URLSearchParams(location.search).get('category') ?? '');
  }
</script>
