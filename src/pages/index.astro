---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import Vitrine from '@/components/world/Vitrine.astro';
import DrawerRail from '@/components/world/DrawerRail.astro';
import AccessionWall from '@/components/world/AccessionWall.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import { leadPiece, pieces } from '@/data/pieces';
---

<Base>
  <SiteHeader />
  <main>
    <Vitrine piece={leadPiece} />
    <DrawerRail />
    <AccessionWall pieces={pieces} />
  </main>
  <SiteFooter />
</Base>
