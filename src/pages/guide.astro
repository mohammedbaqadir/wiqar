---
import Base from '@/layouts/Base.astro';
import SiteHeader from '@/components/world/SiteHeader.astro';
import SiteFooter from '@/components/world/SiteFooter.astro';
import Button from '@/components/starwind/button/Button.astro';
import Badge from '@/components/starwind/badge/Badge.astro';
import Separator from '@/components/starwind/separator/Separator.astro';
import DrawnPiece from '@/components/world/DrawnPiece.astro';
import { palettes } from '@/data/palettes';

const roleChips = (m: (typeof palettes)[number]['day']) => [
  ['room', m.room],
  ['exhibit', m.exhibit],
  ['ink', m.ink],
  ['deep', m.deep],
  ['accent', m.accent],
  ['signal', m.signal],
];
---

<Base title="نظام التصميم — وقار">
  <SiteHeader />
  <main class="mx-auto max-w-6xl space-y-16 px-5 py-10 lg:px-8">
    <header class="space-y-3">
      <p class="font-data text-[0.8rem] tracking-[0.18em] text-accent-d">نظام التصميم</p>
      <h1 class="font-display text-4xl leading-tight wq-ink-room lg:text-5xl">لغة وقار</h1>
      <p class="max-w-prose font-reading text-lg leading-loose wq-ink-room-2">
        القاعدة: <span class="wq-ink-room">الليل يظلم القاعة، لا المعروضات</span>. الأرض والجدران
        تتحول إلى ورنيش داكن بحسب النظام، أما البطاقات واللوحات فتبقى مضاءة. اختر نظامًا من النقاط في
        الأعلى، وبدّل ليل/نهار لتراه حيًّا.
      </p>
    </header>

    <section class="space-y-6">
      <h2 class="font-display text-2xl wq-ink-room">الأنظمة اللونية</h2>

      {
        palettes.map((palette) => (
          <article class="border wq-edge">
            <header class="flex flex-wrap items-center gap-3 wq-wq-surface-room-2 p-4">
              <span
                class="size-6 rounded-full border wq-edge"
                style={`background:${palette.swatch}`}
              />
              <h3 class="font-display text-xl wq-ink-room">{palette.name}</h3>
              <p class="font-data text-[0.7rem] wq-ink-room-3">{palette.note}</p>
              <span class="ms-auto font-data text-[0.65rem] tracking-[0.12em] wq-ink-room-3" dir="ltr">
                {palette.id}
              </span>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2">
              {[
                { label: 'نهار', m: palette.day },
                { label: 'ليل', m: palette.night },
              ].map(({ label, m }) => (
                <div class="space-y-3 p-5" style={`background:${m.room}`}>
                  <p class="font-data text-[0.7rem] tracking-[0.14em]" style={`color:${m.roomInk3}`}>
                    {label}
                  </p>

                  <div
                    class="border p-3"
                    style={`background:${m.exhibit}; border-color:${m.hairlineInk}`}
                  >
                    <p
                      class="font-data text-[0.65rem] tracking-[0.14em]"
                      style={`color:${m.ink3}`}
                      dir="ltr"
                    >
                      WQ-0412
                    </p>
                    <p class="font-display text-lg" style={`color:${m.ink}`}>فنجان قهوة</p>
                    <p class="font-reading text-sm leading-loose" style={`color:${m.ink2}`}>
                      جدار رقيق، وحافة مضبوطة، وحجم يقيس القهوة.
                    </p>
                    <span class="mt-2 inline-block h-[3px] w-8" style={`background:${m.accent}`} />
                  </div>

                  <div class="p-3" style={`background:${m.deep}`}>
                    <p class="font-data text-[0.65rem]" style={`color:${m.deepInk2}`}>
                      فهرس المقتنيات
                    </p>
                    <p class="font-display text-base" style={`color:${m.deepInk}`}>
                      القاعة بعد ساعات — اللوحات مضاءة
                    </p>
                    <span class="mt-2 inline-block h-[2px] w-6" style={`background:${m.accent}`} />
                  </div>

                  <div class="flex flex-wrap gap-1.5">
                    {roleChips(m).map(([name, color]) => (
                      <span
                        class="inline-flex items-center gap-1.5 border px-2 py-0.5 font-data text-[0.6rem]"
                        style={`border-color:${m.hairline}; color:${m.roomInk3}`}
                      >
                        <span class="size-3 rounded-full" style={`background:${color}`} />
                        {name}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </section>

    <section class="space-y-5">
      <h2 class="font-display text-2xl wq-ink-room">الخطوط</h2>
      <div class="space-y-6 border wq-edge wq-surface-exhibit p-6">
        <div class="space-y-1">
          <p class="font-data text-[0.7rem] tracking-[0.12em] text-ink-3">NASEEM · عرض</p>
          <p class="font-display text-4xl text-ink">وقار — كل قطعة تدخل بمعيار</p>
        </div>
        <Separator />
        <div class="space-y-1">
          <p class="font-data text-[0.7rem] tracking-[0.12em] text-ink-3">AMIRI · قراءة</p>
          <p class="max-w-prose font-reading text-lg leading-loose text-ink-2">
            لا شيء عاديّ هنا: الجودة والذوق في مرتبة واحدة، والسعر يُقاس على ما يستحقه.
          </p>
        </div>
        <Separator />
        <div class="space-y-1">
          <p class="font-data text-[0.7rem] tracking-[0.12em] text-ink-3">PLEX · واجهة وأرقام</p>
          <p class="text-base text-ink-2">نص الواجهة، الأزرار، والبيانات.</p>
          <p class="font-data text-sm text-ink">WQ-0412 · ١٧٤ ر.س</p>
        </div>
      </div>
    </section>

    <section class="space-y-5">
      <h2 class="font-display text-2xl wq-ink-room">العناصر</h2>
      <div class="space-y-6 border wq-edge wq-surface-exhibit p-6">
        <div class="flex flex-wrap items-center gap-3">
          <Button
            variant="primary"
            class="bg-accent text-ink hover:bg-accent-d hover:text-ink dark:bg-accent dark:text-ink"
            >أضف إلى الطلب</Button
          >
          <Button variant="outline">ثانوي</Button>
          <Button variant="ghost">هادئ</Button>
        </div>
        <Separator />
        <div class="flex flex-wrap items-center gap-3">
          <Badge variant="primary" class="bg-accent text-ink">مميّزة</Badge>
          <Badge variant="outline" class="wq-edge-exhibit text-ink-3">WQ-0412</Badge>
          <Badge variant="error" class="bg-signal text-exhibit">آخر قطعة</Badge>
        </div>
        <Separator />
        <div class="flex flex-wrap items-center gap-6">
          <DrawnPiece kind="cup" class="h-16 w-auto text-ink" />
          <DrawnPiece kind="pen" class="h-16 w-auto text-ink" />
          <DrawnPiece kind="textile" class="h-16 w-auto text-ink" />
          <DrawnPiece kind="perfume" class="h-16 w-auto text-ink" />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
