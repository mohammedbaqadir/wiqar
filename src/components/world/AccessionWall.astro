---
import { url } from '@/lib/url';
import Badge from '@/components/starwind/badge/Badge.astro';
import DrawnPiece from './DrawnPiece.astro';
import type { Piece } from '@/data/pieces';

interface Props {
  pieces: Piece[];
  title?: string;
}

const { pieces, title = 'أحدث المقتنيات' } = Astro.props;
const [lead, ...rest] = pieces;
---

<section class="border-y border-hairline-strong bg-deep py-12">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="mb-8 flex items-end justify-between gap-4">
      <h2
        class="relative pb-3 font-display text-3xl text-ground after:absolute after:bottom-0 after:start-0 after:h-[3px] after:w-12 after:bg-accent"
      >
        {title}
      </h2>
      <a href={url('/catalog')} class="text-sm text-ground/80 transition-colors hover:text-accent-l">
        الفهرس كاملًا
      </a>
    </div>

    <a
      href={url('/sheet')}
      class="group mb-8 grid items-center gap-6 border border-accent/60 bg-paper p-6 transition-colors hover:border-accent md:grid-cols-[1fr_1.2fr]"
    >
      <DrawnPiece kind={lead.kind} class="mx-auto h-48 w-auto text-ink" />
      <div class="space-y-2">
        <p class="font-data text-[0.7rem] tracking-[0.2em] text-accent-d" dir="ltr">{lead.no}</p>
        <h3 class="font-display text-3xl text-ink">{lead.name}</h3>
        <p class="max-w-prose font-reading text-lg leading-loose text-ink-2">{lead.standard}</p>
        <p class="font-data text-xs text-ink-3">{lead.origin}</p>
      </div>
    </a>

    <div class="group/wall grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((piece) => (
          <a
            href={url('/sheet')}
            class="flex flex-col gap-3 border border-hairline bg-paper p-5 transition-all duration-300 group-hover/wall:opacity-60 hover:border-accent hover:opacity-100!"
          >
            <div class="flex items-start justify-between gap-3">
              <DrawnPiece kind={piece.kind} class="h-20 w-auto text-ink" />
              <Badge
                variant="outline"
                size="sm"
                class="border-hairline-strong font-data text-[0.65rem] tracking-[0.12em] text-ink-3"
              >
                <span dir="ltr">{piece.no}</span>
              </Badge>
            </div>
            <h3 class="font-display text-xl text-ink">{piece.name}</h3>
            <p class="font-reading text-base leading-loose text-ink-2">{piece.standard}</p>
            <p class="mt-auto font-data text-[0.7rem] text-ink-3">{piece.origin}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
