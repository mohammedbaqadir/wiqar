---
import DrawnPiece from './DrawnPiece.astro';
import { url } from '@/lib/url';
import { money, toArabicDigits } from '@/lib/format';
import type { Piece } from '@/data/pieces';

interface Props {
  pieces: Piece[];
  title?: string;
}

const { pieces, title = 'مقتنيات مختارة' } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 py-14 lg:px-8">
  <header class="mb-8 flex items-end justify-between gap-4">
    <h2 class="font-display text-2xl text-room-ink lg:text-3xl">{title}</h2>
    <a
      href={url('/catalog')}
      class="text-sm text-room-ink-2 underline decoration-hairline underline-offset-4 transition-colors hover:text-room-ink hover:decoration-accent"
    >
      المتجر كاملًا
    </a>
  </header>

  <div class="grid grid-cols-2 gap-x-4 gap-y-10 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-6">
    {
      pieces.map((piece) => (
        <a href={url('/sheet')} class="group flex flex-col">
          <div class="relative aspect-4/5 w-full overflow-hidden bg-exhibit-2">
            <DrawnPiece
              kind={piece.kind}
              class="absolute inset-0 m-auto h-2/3 w-auto text-ink/85 transition-transform duration-500 ease-out group-hover:scale-[1.04]"
            />
            {piece.lowStock && (
              <span class="absolute start-3 top-3 bg-signal px-2 py-0.5 font-data text-[0.6rem] text-exhibit">
                آخر {toArabicDigits(piece.lowStock)}
              </span>
            )}
          </div>

          <div class="mt-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="truncate text-[0.95rem] text-room-ink group-hover:underline group-hover:decoration-accent group-hover:decoration-2 group-hover:underline-offset-4">
                {piece.name}
              </h3>
              <p class="mt-1 font-data text-[0.65rem] tracking-[0.12em] text-room-ink-3" dir="ltr">
                {piece.no}
              </p>
            </div>
            <div class="shrink-0 text-end">
              <p class="font-data text-sm text-room-ink">{money(piece.price)}</p>
              {piece.compareAt && (
                <p class="font-data text-[0.7rem] text-room-ink-3 line-through">
                  {money(piece.compareAt)}
                </p>
              )}
            </div>
          </div>

          <span
            class="mt-2 hidden font-data text-[0.7rem] tracking-[0.08em] text-accent-d group-hover:inline"
          >
            أضف إلى السلة +
          </span>
        </a>
      ))
    }
  </div>
</section>
