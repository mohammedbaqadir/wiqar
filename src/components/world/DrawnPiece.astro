---
import type { PieceKind } from '@/data/pieces';

interface Props {
  kind: PieceKind;
  class?: string;
}

const { kind, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 200"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {kind === 'cup' && (
    <g>
      <path d="M56 70h72v52a26 26 0 0 1-26 26H82a26 26 0 0 1-26-26z" />
      <path d="M128 84h12a16 16 0 0 1 0 32h-12" />
      <path d="M46 160h92" />
      <path d="M84 52c0-8 6-10 6-18M104 52c0-8 6-10 6-18" stroke-opacity="0.55" />
    </g>
  )}
  {kind === 'pen' && (
    <g>
      <path d="M62 138l64-96 12 8-64 96z" />
      <path d="M62 138l-10 20 22-8" />
      <path d="M74 146l10 4" stroke-opacity="0.6" />
      <path d="M138 46l10-4 6 10-8 6" stroke-opacity="0.7" />
    </g>
  )}
  {kind === 'textile' && (
    <g>
      <path d="M46 78h108v58H46z" />
      <path d="M46 100h108" stroke-opacity="0.5" />
      <path d="M46 120h108" stroke-opacity="0.5" />
      <path d="M52 78c6-10 12 10 18 0s12 10 18 0 12 10 18 0 12 10 18 0 12 10 18 0" stroke-opacity="0.8" />
      <path d="M56 148c8 6 16-6 24 0s16-6 24 0 16-6 24 0 12-4 18 0" stroke-opacity="0.35" />
    </g>
  )}
  {kind === 'perfume' && (
    <g>
      <path d="M74 88h52v62a10 10 0 0 1-10 10H84a10 10 0 0 1-10-10z" />
      <path d="M92 88V72h16v16" />
      <path d="M86 62h28l-4-10H90z" />
      <path d="M112 44l6-6 8 8-6 6z" stroke-opacity="0.7" />
      <path d="M74 112h52" stroke-opacity="0.45" />
    </g>
  )}
  {kind === 'bowl' && (
    <g>
      <path d="M48 92h104c0 30-22 50-52 50S48 122 48 92z" />
      <ellipse cx="100" cy="92" rx="52" ry="12" />
      <path d="M78 112c8 6 14 8 22 8s14-2 22-8" stroke-opacity="0.45" />
    </g>
  )}
  {kind === 'lamp' && (
    <g>
      <path d="M100 168V96" />
      <path d="M74 168h52" />
      <path d="M70 96h60l-14-30H84z" />
      <path d="M100 66V54" stroke-opacity="0.6" />
      <path d="M74 132h52" stroke-opacity="0.35" />
    </g>
  )}
</svg>
