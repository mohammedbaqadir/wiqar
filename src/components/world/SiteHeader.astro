---
import { url } from '@/lib/url';

const links = [
  { href: url('/catalog'), label: 'المتجر' },
  { href: url('/sheet'), label: 'قطعة' },
  { href: url('/guide'), label: 'اللغة' },
];
---

<header class="relative z-30">
  <div class="border-b border-room bg-room-2">
    <div
      class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-2 text-[0.75rem] text-room-ink-3 lg:px-8"
    >
      <span>توصيل داخل المملكة · إرجاع خلال ١٤ يومًا</span>
      <span class="hidden sm:inline">بيانات مؤقتة — المتجر قيد الإنشاء</span>
    </div>
  </div>

  <div class="border-b border-room bg-room">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-5 px-5 py-5 lg:px-8"
    >
      <a href={url('/')} class="flex items-baseline gap-3">
        <span class="font-display text-3xl leading-none text-room-ink">وقار</span>
        <span
          class="hidden font-data text-[0.65rem] tracking-[0.2em] text-room-ink-3 md:inline"
          dir="ltr">WIỌAR</span
        >
      </a>

      <nav class="flex items-center gap-6 text-sm" aria-label="التنقل">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-room-ink-2 transition-colors hover:text-room-ink hover:underline hover:decoration-accent hover:decoration-2 hover:underline-offset-4"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={url('/catalog')}
          class="inline-flex items-center gap-2 text-room-ink-2 transition-colors hover:text-room-ink"
          aria-label="البحث"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            class="size-4"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6"></circle>
            <path d="M20 20l-4.2-4.2"></path>
          </svg>
        </a>
        <a
          href={url('/sheet')}
          class="inline-flex items-center gap-2 text-room-ink transition-colors hover:text-accent-d"
          aria-label="السلة"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-4"
            aria-hidden="true"
          >
            <path d="M6 8h12l-1 11H7z"></path>
            <path d="M9 8a3 3 0 0 1 6 0"></path>
          </svg>
          <span class="font-data text-[0.7rem] leading-none" dir="ltr">٣</span>
        </a>
      </nav>
    </div>
  </div>
</header>
