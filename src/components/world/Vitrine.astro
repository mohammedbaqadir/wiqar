---
import { url } from '@/lib/url';
import Button from '@/components/starwind/button/Button.astro';
import DrawnPiece from './DrawnPiece.astro';
import type { Piece } from '@/data/pieces';

interface Props {
  piece: Piece;
}

const { piece } = Astro.props;
---

<section
  class="mx-auto grid max-w-6xl grid-cols-1 px-5 pt-6 pb-14 lg:grid-cols-[7fr_4fr] lg:px-8 lg:pb-20"
>
  <div
    class="relative flex min-h-80 items-center justify-center overflow-hidden border border-accent/55 bg-deep p-8 lg:min-h-[68vh]"
  >
    <DrawnPiece kind={piece.kind} class="h-[42vh] max-h-[520px] w-auto text-ground/85" />
    <span
      class="pointer-events-none absolute inset-0 animate-in fade-in bg-[radial-gradient(58%_42%_at_50%_30%,rgba(248,244,232,0.18),transparent_70%)] duration-1000 group-data-[drawer=open]/page:opacity-20"
    ></span>
    <p
      class="absolute bottom-4 start-6 font-data text-xs tracking-[0.18em] text-ground/75"
      dir="ltr"
    >
      {piece.no}
    </p>
  </div>

  <div class="flex flex-col justify-center gap-4 bg-accent p-8 text-ink lg:p-10">
    <p class="font-data text-[0.7rem] tracking-[0.2em] text-ink-2" dir="ltr">{piece.no}</p>
    <h1 class="font-display text-4xl leading-tight text-ink lg:text-5xl">{piece.name}</h1>
    <p class="max-w-prose font-reading text-lg leading-loose text-ink-2">{piece.standard}</p>
    <p class="font-data text-xs text-ink-2">{piece.origin}</p>
    <Button
      as="a"
      href={url('/sheet')}
      variant="outline"
      class="mt-2 self-start border-ink bg-transparent text-ink hover:bg-ink hover:text-ground dark:bg-transparent dark:hover:bg-ink"
    >
      افتح البطاقة
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 12H4M10 6l-6 6 6 6"></path>
      </svg>
    </Button>
  </div>
</section>
