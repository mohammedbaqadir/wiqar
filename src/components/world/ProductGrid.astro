---
import { imageSrc, isLowStock, isOnSale, lowStockLabel, type ApiProduct } from '@/lib/api';
import { money } from '@/lib/format';
import { url } from '@/lib/url';

interface Props {
  products: ApiProduct[];
  title?: string;
}

const { products, title } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 py-12 lg:px-8 lg:py-16">
  {
    title && (
      <header class="mb-8 flex items-end justify-between gap-4">
        <h2 class="font-display text-2xl text-room-ink lg:text-3xl">{title}</h2>
        <a
          href={url('/catalog')}
          class="text-sm text-room-ink-2 underline decoration-hairline underline-offset-4 transition-colors hover:text-room-ink hover:decoration-accent"
        >
          المتجر كاملًا
        </a>
      </header>
    )
  }

  <div class="grid grid-cols-2 gap-x-4 gap-y-9 md:grid-cols-3 lg:grid-cols-4 lg:gap-x-6">
    {
      products.map((product) => (
        <a href={url(`/product/${product.slug}`)} class="group flex flex-col">
          <div class="relative aspect-square w-full overflow-hidden bg-exhibit-2">
            <img
              src={imageSrc(product.image)}
              alt={product.image.alt}
              loading="lazy"
              class="size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
            />
            {isLowStock(product) && (
              <span class="absolute start-3 top-3 bg-signal px-2 py-0.5 font-data text-[0.6rem] text-exhibit">
                {lowStockLabel(product)}
              </span>
            )}
            {isOnSale(product) && (
              <span class="absolute end-3 top-3 bg-ink px-2 py-0.5 font-data text-[0.6rem] text-exhibit">
                عرض
              </span>
            )}
          </div>

          <div class="mt-3 flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h3 class="truncate text-[0.95rem] text-room-ink group-hover:text-accent-d">
                {product.name}
              </h3>
              <p class="mt-1 font-data text-[0.65rem] tracking-[0.12em] text-room-ink-3" dir="ltr">
                {product.sku}
              </p>
            </div>
            <div class="shrink-0 text-end">
              {isOnSale(product) ? (
                <>
                  <p class="font-data text-sm text-room-ink">
                    {money(product.sale_price ?? product.price)}
                  </p>
                  <p class="font-data text-[0.7rem] text-room-ink-3 line-through">
                    {money(product.regular_price)}
                  </p>
                </>
              ) : (
                <p class="font-data text-sm text-room-ink">{money(product.price)}</p>
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
