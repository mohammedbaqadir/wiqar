---
import { getCategories, getProducts } from '@/lib/api';
import { toArabicDigits } from '@/lib/format';
import { url } from '@/lib/url';

const categories = await getCategories();
const products = await getProducts();

const rooms = categories
  .map((category) => ({
    category,
    count: products.filter((product) => product.category_id === category.id).length,
  }))
  .filter((room) => room.count > 0);
---

<nav class="mx-auto max-w-6xl px-5 pb-10 lg:px-8" aria-label="أقسام المتجر">
  <div class="flex flex-wrap border border-hairline">
    {
      rooms.map(({ category, count }) => (
        <a
          href={url(`/category/${category.slug}`)}
          class="flex min-h-11 min-w-0 flex-auto items-center gap-2 border-hairline px-3.5 text-sm whitespace-nowrap text-room-ink transition-colors hover:bg-room-2 [&+&]:border-s"
        >
          <span class="h-0.5 w-5 bg-accent" aria-hidden="true" />
          <span class="font-medium">{category.name}</span>
          <span class="ms-auto font-data text-[0.7rem] text-room-ink-3" dir="ltr">
            {toArabicDigits(count)}
          </span>
        </a>
      ))
    }
  </div>
</nav>
