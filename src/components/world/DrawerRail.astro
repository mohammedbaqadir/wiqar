---
import { pieces } from '@/data/pieces';

const drawers = [
  { label: 'خزف', kinds: ['cup', 'bowl'] },
  { label: 'أقلام', kinds: ['pen'] },
  { label: 'أقمشة', kinds: ['textile'] },
  { label: 'عطور', kinds: ['perfume'] },
  { label: 'إضاءة', kinds: ['lamp'] },
];

const items = drawers.map((drawer) => ({
  label: drawer.label,
  pieces: pieces.filter((piece) => drawer.kinds.includes(piece.kind)),
}));
---

<nav class="relative z-20 mx-auto max-w-6xl px-5 pb-10 lg:px-8" aria-label="أدراج القاعة">
  <div class="flex overflow-x-auto border border-hairline [scrollbar-width:none]">
    {
      items.map((drawer) => (
        <div
          class="group/drawer relative min-w-40 flex-1 border-hairline [&+&]:border-s"
          data-drawer
        >
          <button
            type="button"
            data-front
            class="flex w-full items-center gap-2 bg-ground px-3.5 py-3 text-start text-sm text-ink transition-colors hover:bg-ground-2 group-data-[open]/drawer:bg-deep group-data-[open]/drawer:text-ground"
            aria-expanded="false"
          >
            <span class="h-0.5 w-6 bg-accent" />
            <span class="font-medium">{drawer.label}</span>
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="ms-auto size-3.5 opacity-60 transition-transform group-data-[open]/drawer:rotate-180"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </button>

          <div class="absolute inset-x-0 top-full z-30 hidden flex-col gap-2 border border-accent bg-deep p-3.5 shadow-[0_18px_40px_rgba(20,22,18,0.3)] group-data-[open]/drawer:flex">
            {drawer.pieces.map((piece) => (
              <a href="/catalog" class="flex items-baseline justify-between gap-3 text-sm text-ground/90 transition-colors hover:text-accent-l">
                <span>{piece.name}</span>
                <span class="font-data text-[0.65rem] tracking-[0.12em] text-ground/50" dir="ltr">
                  {piece.no}
                </span>
              </a>
            ))}
            <a href="/catalog" class="border-t border-ground/15 pt-2 text-sm font-medium text-ground transition-colors hover:text-accent-l">
              كل الأدراج
            </a>
          </div>
        </div>
      ))
    }
  </div>
</nav>

<script>
  const rail = document.querySelector<HTMLElement>('[aria-label="أدراج القاعة"]');

  if (rail) {
    const closeAll = () => {
      rail.querySelectorAll<HTMLElement>('[data-drawer]').forEach((drawer) => {
        drawer.removeAttribute('data-open');
        drawer.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
      document.body.removeAttribute('data-drawer');
    };

    rail.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest('[data-front]');
      if (!button) return;
      const drawer = button.parentElement as HTMLElement;
      const wasOpen = drawer.hasAttribute('data-open');
      closeAll();
      if (!wasOpen) {
        drawer.setAttribute('data-open', '');
        button.setAttribute('aria-expanded', 'true');
        document.body.setAttribute('data-drawer', 'open');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeAll();
    });
  }
</script>
